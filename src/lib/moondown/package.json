{
  "name": "moondown",
  "version": "0.1.0",
  "description": "流式 Markdown 渲染组件库",
  "type": "module",
  "svelte": "./index.ts",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "svelte": "./index.ts",
      "types": "./index.ts",
